{
  "name": "zero-vscode",
  "displayName": "Zero",
  "description": "Offline inline completions powered by the Zero daemon's model gateway (Gemini Nano or a local Ollama-compatible model).",
  "version": "0.8.0",
  "type": "module",
  "private": true,
  "publisher": "varunkumar",
  "author": {
    "name": "Varunkumar Nagarajan"
  },
  "icon": "icon.png",
  "engines": { "vscode": "^1.104.0" },
  "repository": {
    "type": "git",
    "url": "https://github.com/varunkumar/zero.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/varunkumar/zero/issues"
  },
  "homepage": "https://github.com/varunkumar/zero#readme",
  "categories": ["Programming Languages", "Machine Learning", "AI", "Chat"],
  "keywords": [
    "completions",
    "autocomplete",
    "offline",
    "local-first",
    "ollama",
    "gemini nano",
    "ai"
  ],
  "galleryBanner": {
    "color": "#0B0B0F",
    "theme": "dark"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "languageModelChatProviders": [
      { "vendor": "zero", "displayName": "Zero" }
    ]
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=esm --external:vscode --outfile=dist/extension.js",
    "package": "bun run build && vsce package --no-dependencies"
  },
  "dependencies": {
    "@zero/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.0"
  }
}
